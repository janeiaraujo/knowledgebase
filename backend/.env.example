# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/incident-kb?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OpenAI API
OPENAI_API_KEY=sk-...

# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=incident-kb-files
R2_PUBLIC_URL=https://your-bucket.r2.dev

# Email (Magic Link)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@incidentkb.com

# Asaas Payment Gateway
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
ASAAS_WALLET_ID=

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=60000

# Frontend URL (for CORS and magic links)
FRONTEND_URL=http://localhost:5173
