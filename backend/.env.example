# =============================================================================
# Copie este arquivo para `.env` e ajuste os valores:  cp .env.example .env
#
# Apenas a secao OBRIGATORIO precisa estar preenchida para rodar o projeto.
# Todas as integracoes externas sao OPCIONAIS: sem elas a aplicacao sobe
# normalmente e apenas o recurso correspondente fica desabilitado.
# =============================================================================

# --- OBRIGATORIO ------------------------------------------------------------

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# MongoDB local via Docker (docker compose up -d) - padrao recomendado.
# Para MongoDB Atlas, use: mongodb+srv://usuario:senha@cluster.mongodb.net/incident_intelligence
MONGODB_URI=mongodb://localhost:27017/incident_intelligence

# Segredos de assinatura dos tokens JWT.
# GERE VALORES PROPRIOS com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-valor-aleatorio-longo
JWT_REFRESH_SECRET=troque-por-outro-valor-aleatorio-longo
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d

# URL do frontend (CORS e links de magic link)
FRONTEND_URL=http://localhost:5173

# URL publica do backend. Usada para montar links que apontam pra ca mesmo
# (upload de arquivos locais, endpoint de ingestao de eventos exibido na
# tela de Eventos). Padrao: http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:3000

# Rate limiting global (por IP, vale para toda a API).
# As rotas de autenticacao tem limites proprios e mais restritos, definidos
# em codigo (backend/src/modules/auth/auth.routes.js) - alterar os valores
# abaixo nao afrouxa a protecao contra forca bruta no login.
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=60000


# --- OPCIONAL: IA (OpenAI) --------------------------------------------------
# Sem esta chave, as rotas de IA respondem 503 e o restante do sistema funciona.
# Afeta: geracao de rascunhos, busca semantica, RCA e post-mortem assistido.
OPENAI_API_KEY=


# --- OPCIONAL: Armazenamento de arquivos (Cloudflare R2) --------------------
# Sem estas variaveis, os uploads caem automaticamente para o disco local
# (pasta backend/uploads). Nenhuma conta externa e necessaria.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_ENDPOINT=


# --- OPCIONAL: E-mail SMTP (magic link) -------------------------------------
# Sem SMTP, o login por magic link fica indisponivel; o login por
# e-mail e senha continua funcionando normalmente.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=


# --- OPCIONAL: Gateway de pagamento (Asaas) ---------------------------------
# Necessario apenas para os recursos de billing/assinatura.
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
ASAAS_WALLET_ID=
