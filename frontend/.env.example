# Copie para `.env`:  cp .env.example .env
#
# URL relativa faz as chamadas passarem pelo proxy do Vite (vite.config.js),
# funcionando em localhost e atras de tuneis (ngrok) sem mixed-content.
# Para apontar direto para um backend remoto, use a URL absoluta da API.
VITE_API_URL=/api

# WebSocket. Se vazio, e derivado automaticamente do host atual
# (usa wss:// quando a pagina esta em HTTPS). Normalmente nao precisa mexer.
# VITE_WS_URL=
